{"nodes": [{"id": "docs_bedah_scorm_klc2_skp_bedah_scorm_klc2", "label": "Bedah SCORM KLC2 \"Penyusunan Sasaran Kinerja Pegawai\"", "file_type": "document", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": null, "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Kursus dibungkus sebagai paket SCORM tapi nol panggilan API_1484_11/cmi.*; pelaporannya lewat xAPI ke server luar."}, {"id": "docs_bedah_scorm_klc2_skp_fluid_clamp_sizing", "label": "Ukuran fluid clamp(min, min(vw,vh), max)", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a74 poin 1; \u00a79 prioritas Tinggi", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Kunci min(vw,vh): ukuran mengikuti sisi terpendek viewport, jadi satu slide muat tanpa scroll baik di layar lebar-pendek (proyektor) maupun tinggi-sempit. Jauh lebih sederhana daripada auto-scale JS."}, {"id": "docs_bedah_scorm_klc2_skp_searchtext_per_slide", "label": "Indeks searchText per slide", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a72.3; \u00a79 prioritas Tinggi", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Tiap slide punya kembaran teks polos sehingga pencarian isi tidak perlu mem-parse DOM; builder bisa meng-generate searchText otomatis dari blok teks."}, {"id": "docs_bedah_scorm_klc2_skp_resume_localstorage_stempel_build", "label": "Resume localStorage ber-stempel build", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a72.2", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Nama key memuat ID build, jadi begitu modul di-build ulang key berubah dan progres lama otomatis dibuang - tidak ada state basi yang menabrak struktur slide baru. Whitelist nilai screen mencegah state korup bikin layar kosong."}, {"id": "docs_bedah_scorm_klc2_skp_preloader_import_meta_glob", "label": "Preloader import.meta.glob dengan progres nyata", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a72.4", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "import.meta.glob membuat daftar aset otomatis sehingga tidak ada manifest yang perlu dipelihara, dan layar muat menampilkan persentase asli plus nama berkas yang sedang diambil."}, {"id": "docs_bedah_scorm_klc2_skp_token_warna_blok", "label": "Token warna blok colorClasses(name)", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a74 akhir; \u00a79 prioritas Tinggi", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Penulis konten memilih nama warna ('indigo','teal',...), bukan menulis delapan kelas Tailwind; helper mengembalikan {card, iconBg, icon, checkIcon} untuk light dan dark sekaligus."}, {"id": "docs_bedah_scorm_klc2_skp_kartu_modal_detail", "label": "Pola kartu -> modal detail", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a74 poin 4", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Ringkasan pendek (shortSummary) di kartu, detail panjang (detailGroups) baru muncul di overlay - memecah teks padat regulasi jadi interaksi."}, {"id": "docs_bedah_scorm_klc2_skp_mesin_layar", "label": "Mesin layar (state machine di root)", "file_type": "concept", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a72.1", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Satu useState 'screen' plus tiga indeks, tanpa router; semua transisi lewat callback."}, {"id": "docs_bedah_scorm_klc2_skp_konvensi_folder_aset", "label": "Konvensi folder aset group-N/slideNo", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a78", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Nomor slide = nama folder membuat pemetaan aset bebas konfigurasi, tanpa manifest."}, {"id": "docs_bedah_scorm_klc2_skp_mesin_kuis", "label": "Mesin kuis generik (ambang lulus 70%)", "file_type": "concept", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a73 quiz", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Satu QuizEngine dipakai ulang dengan data soal ringkas; papan nomor berwarna, badge soal kosong, dan tombol kirim terkunci sampai semua terisi adalah UX yang sudah matang."}, {"id": "docs_bedah_scorm_klc2_skp_xapi_pihak_ketiga", "label": "Anti-pola: xAPI ke domain pihak ketiga", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a77; \u00a79 baris Hindari", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Nama, email, dan URL foto peserta dikirim ke domain pribadi pihak ketiga, bukan infrastruktur Kemenkeu - isu tata kelola data. Data dummy dalam bundel ikut mem-publish identitas seorang pegawai. Untuk pelaporan ke LMS, SCORM API asli lebih tepat dan tidak butuh izin jaringan keluar."}, {"id": "docs_bedah_scorm_klc2_skp_scraping_next_data", "label": "Scraping __NEXT_DATA__ untuk identitas peserta", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a77 \"Cara modul mengenali peserta\"", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Modul mengorek __NEXT_DATA__ dari halaman depan KLC2 dengan cookie sesi karena iframe SCORM tidak diberi identitas. Rapuh: begitu KLC2 ganti versi Next.js atau bentuk sesi, identitas hilang dan xAPI diam-diam berhenti (return null, cuma console.warn)."}, {"id": "docs_bedah_scorm_klc2_skp_verifikasi_bundel", "label": "Cara memverifikasi ulang temuan bedah", "file_type": "rationale", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a710", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Bundel diminifikasi tapi string tidak diobfuskasi, dan esbuild memakai backtick untuk semua literal string - jadi cari dengan pola backtick, bukan tanda kutip ganda. Kode aplikasi ada di ekor berkas."}, {"id": "docs_bedah_scorm_klc2_skp_viewer_pdf_pdfjs", "label": "Slide viewer PDF berbasis pdf.js", "file_type": "concept", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a75", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Dokumen regulasi tidak jadi lampiran terpisah tapi bisa ditelusuri di dalam modul; harganya berat (~1 MB bundel), jadi hanya dipakai bila regulasi wajib inline."}, {"id": "docs_bedah_scorm_klc2_skp_tiga_jalur_audio", "label": "Tiga jalur audio terpisah (narasi, musik latar, SFX)", "file_type": "concept", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a76", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": "Satu context global memisahkan narasi per slide, musik latar, dan SFX sehingga volume/mute tiap jalur bisa dikendalikan sendiri-sendiri."}, {"id": "docs_bedah_scorm_klc2_skp_daftar_ambil_untuk_builder", "label": "Daftar ambil-untuk-builder (prioritas)", "file_type": "document", "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a79", "source_url": "https://klc2.kemenkeu.go.id/scorm/2026/9/14/1789346419366ugx/dist/index.html", "captured_at": "2026-09-14", "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_bedah_scorm_klc2_skp_searchtext_per_slide", "target": "app_src_paket_paket_shell_cocok", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "\u00a72.3 pencarian tanpa mem-parse DOM vs pencarian atas metadata MODUL", "weight": 1.0}, {"source": "docs_bedah_scorm_klc2_skp_token_warna_blok", "target": "app_src_paket_paket_shell_token_warna_per_konsep", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "keduanya memetakan satu nama pilihan ke satu set token visual lengkap", "weight": 1.0}, {"source": "docs_bedah_scorm_klc2_skp_resume_localstorage_stempel_build", "target": "app_src_paket_paket_shell_document_write_bukan_blob", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/bedah-scorm-klc2-skp.md", "source_location": "keduanya soal menjaga progres di localStora